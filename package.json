{
  "name": "medicine-api",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "rm $(DB_FILE_NAME) && bun x --bun drizzle-kit generate && bun run db:migrate && bun run ./db/seed.ts",
    "db:migrate": "bun run ./db/migrate.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "bun run index.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "effect": "^3.19.3",
    "elysia": "^1.4.15"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
